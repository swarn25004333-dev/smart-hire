# ============================================================================
# Smart Hire backend environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# SECURITY:
#   - Never commit your real `.env` file (it is already git-ignored).
#   - Never hardcode API keys in source code.
#   - API keys are read ONLY from these environment variables on the backend.
#   - Smart Hire works WITHOUT any API key using its offline heuristic engine.
# ============================================================================

# --- AI provider (leave empty to use the offline heuristic engine) ----------
# Groq is called through the OpenAI SDK using the OpenAI-compatible endpoint.
# Put your Groq API key in OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Legacy Gemini settings (no longer used by the AI client).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Seconds to wait for an AI provider response before falling back to the
# offline heuristic engine.
AI_TIMEOUT_SECONDS=30

# --- Rate limits (per client IP, SlowAPI "N/minute" syntax) -----------------
GENERAL_RATE_LIMIT=60/minute
AI_SCREEN_RATE_LIMIT=5/minute
AI_ANALYZE_JOB_RATE_LIMIT=10/minute
RESUME_PARSE_RATE_LIMIT=20/minute
COMPARE_RATE_LIMIT=10/minute

# --- General settings -------------------------------------------------------
# CORS origin for the React dev server
FRONTEND_ORIGIN=http://localhost:5173
# Max upload size per resume in bytes (10 MB)
MAX_UPLOAD_SIZE=10485760